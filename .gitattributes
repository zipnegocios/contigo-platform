# Forzar LF en todos los archivos de código (recomendado para Next.js)
* text=auto eol=lf

# Archivos de código fuente
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf

# Archivos de configuración
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.env* text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerignore text eol=lf
