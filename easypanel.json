{
  "version": "1.0.0",
  "name": "contigo-platform",
  "description": "Contigo luxury brand platform with admin dashboard",
  "services": [
    {
      "id": "contigo-app",
      "type": "docker",
      "image": "node:20-alpine",
      "port": 3000,
      "environment": {
        "NODE_ENV": "production"
      },
      "volumes": [
        {
          "source": "/etc/easypanel/projects/contigo-platform/database",
          "destination": "/data"
        }
      ],
      "healthCheck": {
        "type": "http",
        "path": "/api/health",
        "interval": 30,
        "timeout": 5,
        "retries": 3
      }
    }
  ],
  "requiredEnvironments": [
    "DATABASE_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "NEXT_PUBLIC_SITE_URL"
  ],
  "optionalEnvironments": [
    "RESEND_API_KEY",
    "OPENAI_API_KEY",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_URL"
  ]
}
