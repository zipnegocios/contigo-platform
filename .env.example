# ============================================
# CONTIGO PLATFORM - Environment Variables
# ============================================

# DATABASE (PostgreSQL with pgvector)
DATABASE_URL=postgresql://user:password@host:5432/contigo_db

# NEXTAUTH Configuration
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars-required-for-production
NEXTAUTH_URL=https://your-domain.com

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# AI & Embeddings (OpenAI)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=contigo-media
R2_PUBLIC_URL=https://your-public-r2-url.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
ADMIN_EMAIL=admin@yourdomain.com

# Environment
NODE_ENV=production
