# ============================================
# CONTIGO PLATFORM - Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in your values
# For EasyPanel: Set these variables in the deployment panel instead

# DATABASE (PostgreSQL with pgvector)
# Format: postgresql://user:password@host:port/database?sslmode=disable
# Local: Use external host from EasyPanel (31.220.56.1:5436)
# EasyPanel: Use internal host (platforms_contigo-pgdb:5432)
DATABASE_URL=postgresql://ccdbadmin:PASSWORD@HOST:PORT/contigo-db?sslmode=disable

# NEXTAUTH Configuration
# Generate a random 32+ char secret for production
NEXTAUTH_SECRET=generate-random-32-char-secret-here-minimum-required
NEXTAUTH_URL=https://your-domain.com

# Email Service (Resend)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@contigoconstructions.com.au

# AI & Embeddings (OpenAI) - Optional
# Get API key from https://platform.openai.com/api-keys
# Required for semantic search features
OPENAI_API_KEY=sk-your_openai_api_key_here

# Storage (Cloudflare R2) - TODO: Setup after project deployment
# Create R2 bucket at https://dash.cloudflare.com/
# Generate API token in Account > API Tokens
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=contigo-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://contigoconstructions.com.au
ADMIN_EMAIL=admin@contigoconstructions.com.au

# Environment
NODE_ENV=production
